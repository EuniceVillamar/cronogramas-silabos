# Copia este archivo como .env y cambia los valores. Nunca subas .env al repositorio.

# Django
SECRET_KEY=cambia-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# PostgreSQL (lo levanta Docker Compose)
POSTGRES_DB=cronogramas
POSTGRES_USER=cronogramas
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_PORT=5433
DATABASE_URL=postgres://cronogramas:cambia-esta-clave@localhost:5433/cronogramas?connect_timeout=5

# IA de respaldo: desactivada hasta elegir proveedor
LLM_FALLBACK_ENABLED=False
LLM_API_KEY=
LLM_MODEL=
